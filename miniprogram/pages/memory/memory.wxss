.memory-page{min-height:100vh;padding:28rpx 24rpx 60rpx;background:#f6efe7;color:#51443e}
.page-head{padding:8rpx 2rpx 22rpx}.page-title{font-size:46rpx;font-weight:800;margin-top:8rpx}.page-sub{font-size:22rpx;color:#8b786e;line-height:1.6;margin-top:8rpx}
.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7rpx;background:#eaded3;padding:7rpx;border-radius:20rpx;position:sticky;top:0;z-index:5}
.tab{margin:0!important;padding:0 6rpx!important;height:76rpx!important;line-height:76rpx!important;border:0!important;border-radius:15rpx!important;background:transparent!important;color:#88756b!important;font-size:22rpx!important}.tab::after{border:0}.tab.on{background:#fffaf2!important;color:#4f433d!important;font-weight:700;box-shadow:0 4rpx 0 rgba(110,83,68,.12)}
.section{margin-top:20rpx}.composer{padding:22rpx;background:#fffaf2;border:2rpx solid #d8c8bc;border-radius:22rpx;box-shadow:7rpx 8rpx 0 rgba(100,75,62,.08)}
.input,.textarea{width:100%;background:#fff;border:2rpx solid #dccdc1;border-radius:16rpx;font-size:26rpx;color:#51443e;padding:18rpx 20rpx}.input{height:84rpx}.textarea{height:190rpx;line-height:1.6}.textarea.short{height:150rpx;margin-top:12rpx}
.primary,.ghost,.mini,.type{border:0!important}.primary::after,.ghost::after,.mini::after,.type::after{border:0!important}
.primary{min-height:82rpx!important;margin:16rpx 0 0!important;background:#da7e82!important;color:white!important;border-radius:16rpx!important;font-size:24rpx!important;font-weight:700;box-shadow:0 6rpx 0 #ad5c61}
.ghost{min-height:72rpx!important;margin:12rpx 0 0!important;background:#eee3da!important;color:#6f5d54!important;border-radius:15rpx!important;font-size:22rpx!important}
.note-list,.memento-list{display:flex;flex-direction:column;gap:14rpx;margin-top:18rpx}.note-card,.memento-card{position:relative;background:#fffaf2;border:2rpx solid #dfd0c5;border-radius:19rpx;padding:20rpx;box-shadow:5rpx 6rpx 0 rgba(95,72,59,.07)}
.note-meta{display:flex;justify-content:space-between;color:#9a877c;font-size:18rpx}.note-text{font-size:27rpx;line-height:1.7;margin-top:13rpx;white-space:pre-wrap}
.row-actions{display:flex;gap:10rpx;justify-content:flex-end;margin-top:16rpx}.row-actions.vertical{flex-direction:column;margin:0;align-self:center}.mini{min-width:88rpx!important;height:54rpx!important;line-height:54rpx!important;margin:0!important;padding:0 14rpx!important;background:#eee3da!important;color:#68564e!important;border-radius:13rpx!important;font-size:19rpx!important}.mini.danger{background:#f3dddd!important;color:#a65f63!important}
.empty{margin-top:18rpx;padding:36rpx 24rpx;text-align:center;background:#f0e5db;border-radius:18rpx;color:#927f75;font-size:22rpx;line-height:1.7}
.photo-composer .input{margin-bottom:4rpx}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:18rpx}.photo-card{position:relative;overflow:hidden;background:#fffaf2;border:2rpx solid #dfd0c5;border-radius:18rpx}.photo{width:100%;height:230rpx;background:#eaded3}.photo-placeholder{height:230rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;background:#eaded3;font-size:50rpx;color:#7e6b61}.photo-placeholder text{font-size:19rpx}.photo-copy{padding:14rpx}.photo-caption,.photo-by{display:block}.photo-caption{font-size:21rpx;line-height:1.45}.photo-by{font-size:17rpx;color:#9a877c;margin-top:6rpx}.delete-corner{position:absolute!important;right:8rpx;top:8rpx;width:48rpx!important;height:48rpx!important;line-height:45rpx!important;padding:0!important;margin:0!important;border-radius:50%!important;background:rgba(255,250,242,.92)!important;color:#8e5c5f!important;font-size:28rpx!important}.delete-corner::after{border:0!important}
.type-row{display:grid;grid-template-columns:repeat(5,1fr);gap:8rpx;margin-bottom:14rpx}.type{height:66rpx!important;line-height:66rpx!important;margin:0!important;padding:0!important;background:#f2e7dd!important;border-radius:14rpx!important;font-size:27rpx!important}.type.on{background:#f3dca0!important;box-shadow:inset 0 0 0 2rpx #bd8e45}
.photo-pick{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}.photo-pick .ghost{flex:1;margin:0!important}.m-preview{width:82rpx;height:82rpx;border-radius:14rpx;background:#eaded3}
.memento-card{display:grid;grid-template-columns:82rpx minmax(0,1fr) auto;gap:14rpx;align-items:center}.memento-photo,.memento-icon{width:82rpx;height:82rpx;border-radius:14rpx;background:#efe3d9}.memento-icon{display:flex;align-items:center;justify-content:center;font-size:38rpx}.memento-copy{min-width:0}.memento-title{font-size:25rpx;font-weight:700}.memento-meaning{font-size:20rpx;color:#79675e;line-height:1.5;margin-top:5rpx}.memento-by{font-size:17rpx;color:#9a877c;margin-top:7rpx}
@media(max-width:360px){.photo-grid{grid-template-columns:1fr}.page-title{font-size:41rpx}}