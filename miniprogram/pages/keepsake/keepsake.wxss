.keepsake-page{min-height:100vh;padding:30rpx 24rpx 60rpx;background:#ece9e2;color:#4b4946}.top{text-align:center;color:#8d8a84}.paper-card{position:relative;margin-top:22rpx;padding:46rpx 34rpx 30rpx;background:#fffdf8;border:2rpx solid #ddd8cf;border-radius:8rpx;box-shadow:0 18rpx 40rpx rgba(67,61,55,.12);overflow:hidden}.paper-card:before{content:"";position:absolute;left:0;right:0;top:0;height:12rpx;background:repeating-linear-gradient(90deg,#eee8dd 0 14rpx,#fffdf8 14rpx 26rpx)}.paper-stamp{position:absolute;right:30rpx;top:34rpx;width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#efe0a6;color:#8f7043;font-size:36rpx}.date{font-size:18rpx;letter-spacing:3rpx;color:#96918b}.keepsake-title{max-width:510rpx;font-size:52rpx;font-weight:600;font-family:serif;line-height:1.2;margin-top:14rpx}.quote{font-size:22rpx;line-height:1.75;color:#74716d;margin-top:16rpx}.people{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:24rpx}.person-chip{width:56rpx;height:56rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#f1ebe2;border:2rpx solid #d8d0c5;font-size:18rpx}.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:30rpx;border-top:2rpx solid #ece7df;border-bottom:2rpx solid #ece7df}.stats view{text-align:center;padding:20rpx 5rpx;border-right:2rpx solid #ece7df}.stats view:last-child{border-right:0}.stats text{display:block}.stats text{font-size:36rpx;font-family:serif}.stats .stat-label{font-size:16rpx;color:#96918b;margin-top:5rpx}.last-line{margin-top:26rpx;padding:20rpx;background:#f5f1ea;border-left:6rpx solid #c99b91}.last-label,.last-text{display:block}.last-label{font-size:16rpx;color:#99938c;letter-spacing:2rpx}.last-text{font-size:22rpx;line-height:1.7;margin-top:8rpx}.memory-meter{margin-top:28rpx}.meter-head{display:flex;justify-content:space-between;font-size:18rpx;color:#827e78}.meter-bar{display:flex;height:20rpx;overflow:hidden;border-radius:999rpx;background:#eee9e1;margin-top:12rpx}.meter{height:100%}.meter.notes{background:#c98d91}.meter.mementos{background:#d3b56a}.meter.photos{background:#86aebc}.legend{display:flex;gap:18rpx;margin-top:10rpx;font-size:16rpx;color:#8e8983}.legend text:nth-child(1){color:#a76e73}.legend text:nth-child(2){color:#a68b45}.legend text:nth-child(3){color:#628d9d}.footer{display:flex;justify-content:space-between;margin-top:30rpx;font-size:16rpx;letter-spacing:2rpx;color:#9a958e}.actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}.actions button{height:82rpx!important;line-height:82rpx!important;margin:0!important;border:0!important;border-radius:15rpx!important;font-size:21rpx!important}.actions button::after{border:0}.share{background:#d88185!important;color:white!important;box-shadow:0 6rpx 0 #ad5e62}.back{background:#ddd8ce!important;color:#5e5a55!important}.hint{text-align:center;color:#96918b;font-size:18rpx;line-height:1.6;margin-top:20rpx}@media(max-width:360px){.keepsake-title{font-size:44rpx}.stats{grid-template-columns:repeat(2,1fr)}.stats view:nth-child(2){border-right:0}}