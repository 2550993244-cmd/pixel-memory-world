.room-page{padding:24rpx}.room-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.room-title{font-size:34rpx;font-weight:800}.code{font-size:28rpx;letter-spacing:5rpx;background:#f3c969;padding:12rpx 16rpx;border:3rpx solid #745f54;border-radius:8rpx}.pixel-stage{height:620rpx;position:relative;overflow:hidden;background:linear-gradient(#f3dfcd 0 42%,#d8b79d 42%);border:5rpx solid #745f54;box-shadow:10rpx 10rpx 0 #d4c3b4}.pixel-stage:after{content:'';position:absolute;left:0;right:0;top:42%;bottom:0;background-image:linear-gradient(rgba(255,255,255,.22) 2rpx,transparent 2rpx),linear-gradient(90deg,rgba(255,255,255,.18) 2rpx,transparent 2rpx);background-size:64rpx 64rpx}.window{position:absolute;left:50rpx;top:50rpx;width:150rpx;height:120rpx;background:#8fb6c9;border:10rpx solid #745f54;z-index:1}.rug{position:absolute;left:190rpx;right:190rpx;bottom:80rpx;height:180rpx;background:#e98f92;border-radius:50%;z-index:1}.cake{position:absolute;left:50%;top:44%;transform:translateX(-50%);font-size:90rpx;z-index:2}.door{position:absolute;right:30rpx;top:90rpx;width:110rpx;height:190rpx;background:#9bb59c;border:8rpx solid #745f54;z-index:2;color:white;font-size:18rpx;display:flex;align-items:flex-end;justify-content:center;padding-bottom:8rpx}.person{position:absolute;width:52rpx;height:74rpx;transform:translate(-50%,-50%);z-index:8}.head{width:42rpx;height:38rpx;background:#e4ad8e;border:5rpx solid #554841}.body{width:48rpx;height:38rpx;background:#e98f92;border:5rpx solid #554841;margin-top:-2rpx}.pname{position:absolute;bottom:80rpx;left:50%;transform:translateX(-50%);background:#fffaf2;border:2rpx solid #745f54;padding:3rpx 7rpx;font-size:18rpx;white-space:nowrap}.bubble{position:absolute;left:50%;bottom:34rpx;transform:translateX(-50%);z-index:10;background:#fffaf2;border:3rpx solid #745f54;padding:12rpx 18rpx;max-width:70%}.move-pad{display:grid;grid-template-columns:repeat(3,90rpx);grid-template-rows:repeat(2,74rpx);justify-content:center;gap:8rpx;margin:24rpx 0}.move{padding:0!important;line-height:74rpx;background:#8fb6c9!important;color:white!important;box-shadow:0 7rpx 0 #668b9b;border:0}.up{grid-column:2}.left{grid-column:1}.down{grid-column:2}.right{grid-column:3}.actions{margin-top:12rpx}.online{font-size:24rpx;color:#6a936d;margin-bottom:18rpx}.chatrow{display:flex;gap:12rpx}.chat{flex:1}.mini{width:150rpx;background:#e98f92!important;color:white!important}.action-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:18rpx}.action{font-size:22rpx;line-height:1.3;background:#fff2df!important;border:3rpx solid #d9cabd!important;padding:18rpx 6rpx!important}.action.on{background:#f3c969!important}.action.recording{background:#e98f92!important;color:white!important}.tip{margin:26rpx 8rpx}
