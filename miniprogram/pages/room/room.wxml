<view class="room-page">
  <view class="room-head">
    <view class="room-meta">
      <view class="eyebrow">LIVE PIXEL ROOM</view>
      <view class="room-title">{{honoree}}的小小世界</view>
    </view>
    <view class="room-code">
      <text>{{code}}</text>
      <text class="room-code-label">房间码</text>
    </view>
  </view>

  <view class="status-row">
    <view class="online"><view class="online-dot"></view>{{players.length}} 人在线</view>
    <view class="status-tip">移动、聊天，或者一起庆祝</view>
  </view>

  <view class="pixel-stage">
    <view class="wall"></view>
    <view class="floor"></view>
    <view class="window"></view>
    <view class="string-lights"><view></view><view></view><view></view><view></view><view></view></view>
    <view class="sofa"></view>
    <view class="rug"></view>
    <view class="cake">✦</view>
    <view class="door">OUTSIDE</view>

    <block wx:for="{{players}}" wx:key="id">
      <view class="person {{item.id===playerId?'me':''}}" style="left:{{item.x}}%;top:{{item.y}}%;">
        <view class="pname">{{item.name}}</view>
        <view class="head"></view>
        <view class="body"></view>
      </view>
    </block>

    <view class="bubble" wx:if="{{lastChat}}">{{lastChat}}</view>

    <view class="move-pad">
      <button class="move up" data-dx="0" data-dy="-4" bindtap="move">↑</button>
      <button class="move left" data-dx="-4" data-dy="0" bindtap="move">←</button>
      <button class="move center">✦</button>
      <button class="move right" data-dx="4" data-dy="0" bindtap="move">→</button>
      <button class="move down" data-dx="0" data-dy="4" bindtap="move">↓</button>
    </view>
  </view>

  <view class="chat-panel">
    <view class="chatrow">
      <input class="input chat" value="{{chat}}" bindinput="onChat" bindconfirm="sendChat" confirm-type="send" placeholder="和房间里的人说句话…"/>
      <button class="send" bindtap="sendChat">发送</button>
    </view>
  </view>

  <view class="action-dock">
    <button class="action {{celebrated?'on':''}}" bindtap="celebrate"><text>✦</text><text class="action-label">{{celebrated?'已庆祝':'庆祝'}}</text></button>
    <button class="action {{recording?'recording':''}}" bindtap="toggleRecord"><text>🎙</text><text class="action-label">{{recording?'停止':'录音'}}</text></button>
    <button class="action" bindtap="playLastVoice"><text>▶</text><text class="action-label">最近语音</text></button>
    <button class="action" open-type="share"><text>⌁</text><text class="action-label">邀请好友</text></button>
  </view>

  <view class="room-foot">网页端与小程序端共用同一个房间码和实时房间。</view>
</view>