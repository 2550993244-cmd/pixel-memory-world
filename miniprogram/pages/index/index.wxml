<view class="page">
  <view class="eyebrow">PIXEL MEMORY · WECHAT</view>
  <view class="title">把重要的日子，\n变成一个可以走进去的地方。</view>
  <view class="muted">小程序轻量版先负责邀请、加入房间、聊天、庆祝与录音。网页端和小程序端共用同一个房间码。</view>

  <view class="card panel">
    <view class="tabs">
      <view class="tab {{mode==='join'?'on':''}}" bindtap="setJoin">加入</view>
      <view class="tab {{mode==='create'?'on':''}}" bindtap="setCreate">创建</view>
    </view>

    <block wx:if="{{mode==='join'}}">
      <view class="label">六位邀请码</view>
      <input class="input code" maxlength="6" value="{{code}}" bindinput="onCode" placeholder="8L3Q2K" />
      <view class="label">你的名字</view>
      <input class="input" maxlength="10" value="{{name}}" bindinput="onName" placeholder="小林" />
      <button class="btn" bindtap="joinRoom">找到这间房</button>
    </block>

    <block wx:else>
      <view class="label">为谁创建？</view>
      <input class="input" maxlength="12" value="{{honoree}}" bindinput="onHonoree" placeholder="小羽" />
      <view class="label">你叫什么？</view>
      <input class="input" maxlength="10" value="{{name}}" bindinput="onName" placeholder="房主" />
      <button class="btn" bindtap="createRoom">创建一间联网小屋</button>
    </block>
  </view>
</view>
