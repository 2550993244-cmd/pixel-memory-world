.avatar-page{min-height:100vh;padding:30rpx 26rpx 60rpx;background:linear-gradient(#f3e7dc,#f7f1e8);color:#51443e}.title{font-size:48rpx;font-weight:800;line-height:1.15;margin:10rpx 0}.sub{font-size:22rpx;color:#8b786e;line-height:1.65}
.preview-card{margin-top:26rpx;padding:18rpx;background:#fffaf2;border:3rpx solid #7b6559;border-radius:24rpx;box-shadow:8rpx 9rpx 0 rgba(100,75,62,.12)}.preview-scene{height:330rpx;position:relative;display:flex;align-items:center;justify-content:center;background:linear-gradient(#eedacd 0 56%,#cdaa8e 56%);border-radius:16rpx;overflow:hidden}
.preview-scene:after{content:"";position:absolute;left:0;right:0;top:56%;bottom:0;background-image:linear-gradient(rgba(255,255,255,.18) 2rpx,transparent 2rpx),linear-gradient(90deg,rgba(255,255,255,.15) 2rpx,transparent 2rpx);background-size:58rpx 58rpx}
.pixel-person{position:relative;width:92rpx;height:142rpx;z-index:2}.face{position:absolute;left:17rpx;top:34rpx;width:58rpx;height:54rpx;background:#e7b18f;border:6rpx solid #54463f}.shirt{position:absolute;left:10rpx;top:86rpx;width:72rpx;height:54rpx;border:6rpx solid #54463f}.hair{position:absolute;left:13rpx;top:17rpx;width:66rpx;height:35rpx;background:#664c43;border:6rpx solid #54463f;z-index:3}.hair-2 .hair{height:49rpx;box-shadow:-10rpx 28rpx 0 #664c43,10rpx 28rpx 0 #664c43}.hair-3 .hair{height:60rpx;border-radius:24rpx 24rpx 6rpx 6rpx}.outfit-coral .shirt{background:#df7f84}.outfit-blue .shirt{background:#7fa9bb}.outfit-sage .shirt{background:#91aa8e}.outfit-butter .shirt{background:#efc95f}.held{position:absolute;right:-20rpx;bottom:4rpx;font-size:42rpx;z-index:5}.name-tag{position:absolute;left:50%;top:34rpx;transform:translateX(-50%);padding:6rpx 12rpx;background:#fffaf2;border:2rpx solid #8c7467;border-radius:10rpx;font-size:20rpx;z-index:4}
.builder-card{margin-top:22rpx;padding:24rpx;background:#fffaf2;border:2rpx solid #dccdc1;border-radius:22rpx}.label{font-size:23rpx;font-weight:700;color:#78665d;margin:22rpx 0 10rpx}.label:first-child{margin-top:0}.input{height:84rpx;width:100%;padding:0 18rpx;background:white;border:2rpx solid #dccdc1;border-radius:15rpx;font-size:27rpx}
.choice-row,.swatch-row,.item-row{display:grid;gap:9rpx}.choice-row{grid-template-columns:repeat(3,1fr)}.swatch-row{grid-template-columns:repeat(4,1fr)}.item-row{grid-template-columns:repeat(5,1fr)}button::after{border:0}.choice,.swatch,.item{margin:0!important;padding:0 5rpx!important;height:70rpx!important;line-height:70rpx!important;border-radius:14rpx!important;background:#eee3da!important;color:#65544c!important;font-size:20rpx!important}.choice.on,.item.on{box-shadow:inset 0 0 0 4rpx #a98672;background:#fff8ef!important}.swatch.coral{background:#e7b1b3!important}.swatch.blue{background:#b7d1dc!important}.swatch.sage{background:#c4d4c1!important}.swatch.butter{background:#f3e1a8!important}.swatch.on{box-shadow:inset 0 0 0 5rpx #705a4e}.save{margin:28rpx 0 0!important;height:88rpx!important;line-height:88rpx!important;border:0!important;border-radius:17rpx!important;background:#da7e82!important;color:white!important;font-weight:700;font-size:25rpx!important;box-shadow:0 7rpx 0 #ad5c61}