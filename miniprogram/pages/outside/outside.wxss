.outside-page{min-height:100vh;padding:26rpx 22rpx 60rpx;background:linear-gradient(#dce9cf,#eef0d8 30%,#f6efe7 65%);color:#4f443d}.outside-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.outside-title{font-size:43rpx;font-weight:800;margin-top:8rpx}.outside-sub{max-width:540rpx;font-size:21rpx;line-height:1.55;color:#71806a;margin-top:6rpx}.count{flex:none;margin-top:8rpx;padding:10rpx 14rpx;background:rgba(255,250,242,.76);border:2rpx solid rgba(91,109,80,.25);border-radius:999rpx;font-size:18rpx;color:#607058}
.outdoor-stage{height:720rpx;position:relative;overflow:hidden;margin-top:22rpx;border:4rpx solid #65705b;border-radius:25rpx;background:#a9c58f;box-shadow:8rpx 10rpx 0 rgba(71,86,63,.14)}.sky{position:absolute;inset:0 0 62%;background:#c6dca9}.hill{position:absolute;border-radius:50%;background:#8ead78}.h1{width:520rpx;height:260rpx;left:-150rpx;top:115rpx}.h2{width:500rpx;height:240rpx;right:-180rpx;top:120rpx;background:#91b47d}.path{position:absolute;left:31%;top:0;width:35%;height:120%;background:#d9c38c;transform:rotate(8deg);clip-path:polygon(30% 0,68% 0,100% 100%,0 100%)}.pond{position:absolute;right:40rpx;bottom:90rpx;width:190rpx;height:115rpx;border-radius:50%;background:#86b8c2;border:8rpx solid #789982}.bridge{position:absolute;left:43%;top:49%;width:150rpx;height:52rpx;background:#a98262;border:7rpx solid #6f5848;transform:rotate(8deg)}.tree{position:absolute;z-index:3;font-size:80rpx;color:#52734f;text-shadow:0 13rpx 0 #745b45}.t1{left:35rpx;top:120rpx}.t2{right:42rpx;top:105rpx}.t3{left:80rpx;bottom:95rpx}.mailbox{position:absolute;right:68rpx;top:300rpx;width:72rpx;height:84rpx;background:#d77f75;border:6rpx solid #6f5848;display:flex;align-items:center;justify-content:center;font-size:31rpx;z-index:4}
.quest-marker{position:absolute!important;z-index:9;width:54rpx!important;height:54rpx!important;line-height:48rpx!important;margin:-27rpx 0 0 -27rpx!important;padding:0!important;border:0!important;border-radius:50%!important;background:#fff5c8!important;color:#6d5b42!important;box-shadow:0 0 0 8rpx rgba(243,211,111,.24),0 6rpx 0 rgba(87,70,48,.2);font-size:24rpx!important}.quest-marker::after{border:0}.quest-marker.near{box-shadow:0 0 0 12rpx rgba(243,211,111,.4),0 6rpx 0 rgba(87,70,48,.2)}
.outside-player{position:absolute;z-index:12;width:46rpx;height:65rpx;transform:translate(-50%,-50%);transition:left .08s linear,top .08s linear}.p-face{position:absolute;left:6rpx;top:10rpx;width:34rpx;height:31rpx;background:#e6b08e;border:4rpx solid #51443e}.p-shirt{position:absolute;left:3rpx;top:39rpx;width:40rpx;height:29rpx;border:4rpx solid #51443e}.p-hair{position:absolute;left:4rpx;top:1rpx;width:38rpx;height:20rpx;background:#654d43;border:4rpx solid #51443e;z-index:3}.hair-2 .p-hair{height:29rpx}.hair-3 .p-hair{height:36rpx;border-radius:16rpx}.outfit-coral .p-shirt{background:#df7f84}.outfit-blue .p-shirt{background:#7fa9bb}.outfit-sage .p-shirt{background:#91aa8e}.outfit-butter .p-shirt{background:#efc95f}.p-item{position:absolute;right:-18rpx;bottom:-4rpx;font-size:25rpx}.near-prompt{position:absolute;left:50%;bottom:122rpx;transform:translateX(-50%);z-index:20;max-width:430rpx;padding:12rpx 18rpx;background:rgba(255,250,242,.94);border:2rpx solid #806c5e;border-radius:14rpx;font-size:19rpx;text-align:center}
.move-pad{position:absolute;left:18rpx;bottom:16rpx;z-index:20;display:grid;grid-template-columns:repeat(3,62rpx);grid-template-rows:repeat(3,62rpx);gap:4rpx}.move{width:62rpx!important;height:62rpx!important;min-height:0!important;line-height:62rpx!important;margin:0!important;padding:0!important;border:2rpx solid rgba(86,72,62,.35)!important;border-radius:16rpx!important;background:rgba(255,250,242,.9)!important;color:#5c4c44!important;box-shadow:0 4rpx 0 rgba(70,57,48,.18)!important}.move::after{border:0}.move.up{grid-column:2}.move.left{grid-column:1;grid-row:2}.move.center{grid-column:2;grid-row:2}.move.right{grid-column:3;grid-row:2}.move.down{grid-column:2;grid-row:3}
.quest-editor,.quest-list{margin-top:22rpx;padding:22rpx;background:#fffaf2;border:2rpx solid #d8c9bc;border-radius:22rpx}.editor-title,.list-title{font-size:28rpx;font-weight:800}.editor-sub{font-size:20rpx;color:#89776d;line-height:1.5;margin-top:5rpx}.spot-scroll{width:100%;margin:16rpx 0}.spot-row{display:flex;gap:9rpx;width:max-content}.spot{height:62rpx!important;line-height:62rpx!important;margin:0!important;padding:0 19rpx!important;border:0!important;border-radius:999rpx!important;background:#eee5db!important;color:#6d5b52!important;font-size:20rpx!important;white-space:nowrap}.spot::after,.ghost::after,.save::after,.delete::after,.close::after{border:0}.spot.on{background:#e7d495!important;box-shadow:inset 0 0 0 2rpx #ae894c}.input,.textarea{width:100%;background:white;border:2rpx solid #ddcec2;border-radius:15rpx;padding:17rpx 18rpx;font-size:24rpx;color:#51443e}.input{height:82rpx}.textarea{height:155rpx;line-height:1.55;margin-top:12rpx}.quest-image-row{display:flex;gap:12rpx;align-items:center;margin-top:12rpx}.quest-image-preview{width:90rpx;height:90rpx;border-radius:14rpx}.ghost{flex:1;height:72rpx!important;line-height:72rpx!important;margin:0!important;border:0!important;border-radius:15rpx!important;background:#eee5db!important;color:#6d5b52!important;font-size:20rpx!important}.save{height:84rpx!important;line-height:84rpx!important;margin:16rpx 0 0!important;border:0!important;border-radius:16rpx!important;background:#7da48a!important;color:white!important;font-size:24rpx!important;font-weight:700;box-shadow:0 6rpx 0 #5b7c65}
.quest-card{display:grid;grid-template-columns:58rpx 1fr auto;gap:12rpx;align-items:center;padding:16rpx 0;border-bottom:2rpx solid #eee2d8}.quest-card:last-child{border-bottom:0}.quest-icon{width:54rpx;height:54rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#f4e8b6;font-size:25rpx}.quest-copy text{display:block}.quest-card-title{font-size:22rpx;font-weight:700}.quest-card-by{font-size:17rpx;color:#938075;margin-top:3rpx}.arrow{font-size:34rpx;color:#a18e83}.empty{padding:28rpx 12rpx;text-align:center;color:#8d7c72;font-size:21rpx}
.detail-mask{position:fixed;inset:0;z-index:200;display:flex;align-items:flex-end;background:rgba(48,44,38,.4)}.detail-sheet{width:100%;padding:28rpx 26rpx calc(28rpx + env(safe-area-inset-bottom));background:#fffaf2;border-radius:32rpx 32rpx 0 0}.detail-icon{font-size:50rpx}.detail-title{font-size:34rpx;font-weight:800;margin-top:6rpx}.detail-image{width:100%;height:300rpx;border-radius:17rpx;margin-top:16rpx}.detail-text{font-size:24rpx;line-height:1.7;margin-top:17rpx}.detail-meta{font-size:18rpx;color:#928076;margin-top:13rpx}.delete,.close{height:78rpx!important;line-height:78rpx!important;margin:16rpx 0 0!important;border:0!important;border-radius:15rpx!important;font-size:21rpx!important}.delete{background:#f2dddd!important;color:#9d5d61!important}.close{background:#e7e0d3!important;color:#5e594d!important}