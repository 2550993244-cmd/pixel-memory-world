page{background:#f7f1e8;color:#554841;font-family:monospace}.page{padding:32rpx}.card{background:#fffaf2;border:4rpx solid #745f54;box-shadow:8rpx 8rpx 0 #d8c7b8;padding:28rpx;border-radius:12rpx}.btn{margin-top:20rpx;background:#e98f92!important;color:#fff!important;border:0;border-radius:10rpx;box-shadow:0 10rpx 0 #b86369;font-weight:700}.btn:active{transform:translateY(8rpx);box-shadow:0 2rpx 0 #b86369}.btn.secondary{background:#8fb6c9!important;box-shadow:0 10rpx 0 #668b9b}.label{font-size:24rpx;color:#8d7c72;margin:18rpx 0 8rpx}.input{background:white;border:3rpx solid #d9cabd;padding:20rpx;border-radius:8rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#a47d6b}.title{font-size:48rpx;font-weight:800;line-height:1.25;margin:12rpx 0}.muted{color:#8d7c72;font-size:24rpx;line-height:1.7}
